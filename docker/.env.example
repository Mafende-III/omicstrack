# ============================================
# OmicsTrack Production Environment
# ============================================
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Generate secrets with:
#   openssl rand -hex 32
# ============================================

# Database password (use a strong random password)
DB_PASSWORD=

# JWT secrets (each should be unique, 64+ chars)
JWT_SECRET=
JWT_REFRESH_SECRET=
